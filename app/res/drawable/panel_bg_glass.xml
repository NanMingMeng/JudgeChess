<?xml version="1.0" encoding="utf-8"?>
<!--
  v4.7 个性化：背景板开启时用的面板底 —— 半透明玻璃感。

  ★ 数值是实测调出来的，改之前先看这条算式：
     人物可见度 ≈ (1 - solid 的 alpha) × 背景不透明度 × (1 - scrim 的 alpha)
  原来写 0xD0（82%）时，0.18 × 0.40 × 0.8 ≈ 6% —— 人像基本看不见（截图验证过）。
  现在降到 0x8C（55%），0.45 × 0.40 × 0.8 ≈ 14%，人像轮廓清楚，
  而按钮 / 文字仍落在足够暗的底上（左侧另有 scrim 兜底）。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="#8C0D1116" />
    <stroke android:width="1dp" android:color="#26FFFFFF" />
    <corners android:radius="@dimen/panel_radius" />
</shape>
